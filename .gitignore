# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.artifacts/
/.lighthouseci/
/lhci-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example
!.env.production

# vercel
.vercel

# wrangler 로컬 CF 빌드·dev 산출물(9/23 로컬 빌드가 남긴 30MB 번들 — lint 오염, 커밋 금지)
/.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifacts / logs (root level only — _archive/ keeps history)
/*.log
/build_*.txt
/tsc_errors.log

# claude code worktrees and session data
/.claude/worktrees/
/.claude/sessions/

# DART ETL 로컬 캐시 (scripts/dart-etl.mjs) — API 원본 응답, 커밋 금지
scripts/.dart-cache/
qa-report.md
