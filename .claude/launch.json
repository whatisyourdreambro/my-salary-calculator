{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "qa:dev",
        "--",
        "--port",
        "3000"
      ],
      "port": 3000
