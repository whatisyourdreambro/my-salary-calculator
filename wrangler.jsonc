{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local migration configuration. This is not an existing production Worker identity.
  "name": "moneysalary-opennext-local",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  }
  // No account_id, routes, remote bindings or guessed database ids.
  // Before any separately authorized deployment, configure FEEDBACK_DB and
  // FEEDBACK_RATE_LIMIT_SECRET for that environment. Without both, APIs return 503.
}
