// src/lib/taxConstants2026.ts
//
// 2026년 세법·요율 단일 진실 소스 (Single Source of Truth).
//
// 기존엔 TaxLogic.ts 와 bonusTaxCalc.ts 두 파일에 같은 세율 상수가 중복
// 정의되어 있어, 2027년 세율 변경 시 두 곳 모두 손봐야 하는 위험이 있었음.
// 이 파일에 모아두고 두 파일이 import 해 사용.
//
// ★ 2026 블록을 제자리 수정 금지 — 연도 전환은 rates 인자/포인터 상수로 한다.
//   (TaxLogic.calculateSalary2026·bonusTaxCalc.calcBonusNet 의 선택 인자 rates,
//   calculator.ts calculateNetSalaryWithRates 의 NetSalaryRates.)
//   2026 귀속 연말정산(YearEndTaxCalculator·widget/year-end-tax)과 /table/2026 은
//   2027년에도 2026 요율을 써야 하므로 이 블록 값은 2026 으로 고정한다.















// ─────────────────────────────────────────────────────────────
// 4대보험 요율 (근로자 부담분, 2026년 — 보건복지부 2025-08-28 고시 반영)
// ─────────────────────────────────────────────────────────────
export const INSURANCE_RATES_2026 = {
  /** 국민연금 — 근로자 4.75% (회사 4.75% 별도). 2026 연금개혁: 9%→9.5% (2026-01-01 시행, 2033년까지 매년 0.5%p씩 13%로). */
  NATIONAL_PENSION: 0.0475,
  /**
   * 건강보험 — 근로자 3.595%.
   * 2026년 전체 7.19% (회사 + 근로자 합), 근로자 절반 부담.
   * 2025년 7.09% → 2026년 7.19% (+0.1%p, 3년만의 인상).
   * 출처: 보건복지부 제15차 건강보험정책심의위원회 (2025-08-28).
   */
  HEALTH_INSURANCE: 0.03595,
  /**
   * 장기요양보험 — 건강보험료의 13.14%.
   * 2026년 소득 대비 0.9448% (2025년 0.9182%에서 인상).
   * 건보료 대비 비율: 2025년 12.95% → 2026년 13.14% (+0.19%p).
   * 출처: 보건복지부 (2025-09).
   */
  LONG_TERM_CARE_RATIO: 0.1314,
  /** 고용보험 — 근로자 0.9%. 변동 없음. */
  EMPLOYMENT_INSURANCE: 0.009,
  /** 지방소득세 — 소득세의 10%. 변동 없음. */
  LOCAL_INCOME_TAX_RATIO: 0.1,
} as const;

/**
 * 4대보험·지방세 요율 묶음의 형태 — INSURANCE_RATES_2026 과 같은 키, 값은 number.
 * (`typeof INSURANCE_RATES_2026` 은 as const 리터럴 타입이라 다른 연도 값을 받을 수 없다.)
 * TaxLogic.calculateSalary2026·bonusTaxCalc.calcBonusNet 의 선택 인자 rates 타입.
 */
export type InsuranceRates = {
  readonly [K in keyof typeof INSURANCE_RATES_2026]: number;
};

// ─────────────────────────────────────────────────────────────
// 국민연금 기준소득월액 상한·하한
// 매년 7월 1일 변경. 2026년 7월 ~ 2027년 6월 적용 기준 (현재 최신).
// 상한 637만→659만, 하한 40만→41만 (2026-07-01 인상). 출처: 국민연금공단.
// ─────────────────────────────────────────────────────────────
export const PENSION_BASE_2026 = {
  /** 월 상한 (원) */
  MAX_MONTHLY: 6_590_000,
  /** 월 하한 (원) */
  MIN_MONTHLY: 410_000,
  /** 연 상한 (원) — 성과급 합산 계산용 */
  MAX_ANNUAL: 6_590_000 * 12, // 79_080_000
} as const;

































































































































































































// ─────────────────────────────────────────────────────────────
// 2025년 레거시 요율 — "전년 대비 변화액" 산출 전용 (표의 changeValue 기준선).
// 2026 계산에는 절대 사용하지 말 것. 2027 개정 시 이 블록은 2026 값으로 교체.
// ─────────────────────────────────────────────────────────────
export const INSURANCE_RATES_2025_LEGACY = {
  /** 국민연금 — 근로자 4.5% (연금개혁 전) */
  NATIONAL_PENSION: 0.045,
  /** 건강보험 — 근로자 3.545% (전체 7.09%) */
  HEALTH_INSURANCE: 0.03545,
  /** 장기요양보험 — 건강보험료의 12.95% */
  LONG_TERM_CARE_RATIO: 0.1295,
  /** 고용보험 — 근로자 0.9% */
  EMPLOYMENT_INSURANCE: 0.009,
  /** 지방소득세 — 소득세의 10% */
  LOCAL_INCOME_TAX_RATIO: 0.1,
} as const;

export const PENSION_BASE_2025_LEGACY = {
  /** 월 상한 (원) — 2025.7~2026.6 적용 637만원 */
  MAX_MONTHLY: 6_370_000,
  /** 월 하한 (원) */
  MIN_MONTHLY: 400_000,
} as const;
