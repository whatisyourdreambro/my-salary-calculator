{
  "name": "my-salary-calculator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/qa-server.mjs dev",
    "prebuild": "tsx scripts/gen-guides-meta.ts && tsx scripts/gen-site-metrics.ts && tsx scripts/gen-salary-amounts.ts && tsx scripts/gen-season-key.ts && node scripts/ad-audit.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "verify:tax": "node scripts/verify-tax-constants.mjs",
    "verify:sitemap": "tsx scripts/verify-sitemap.ts",
    "ledger:update": "tsx scripts/verify-sitemap.ts --update-ledger",
    "analyze": "node -e \"process.env.ANALYZE='true'; require('child_process').execSync('npx next build',{stdio:'inherit',env:process.env})\"",
    "ad-audit": "node scripts/ad-audit.mjs",
    "postbuild": "node scripts/indexnow-ping.mjs || echo [indexnow] skipped",
    "verify:site": "tsx scripts/gen-site-metrics.ts --check && tsx scripts/gen-salary-amounts.ts --check && tsx scripts/gen-season-key.ts --check && tsx scripts/verify-company-salary-hrefs.ts",
    "verify:companies": "tsx scripts/verify-company-data.ts",
    "verify:bonus": "node scripts/verify-bonus-data.mjs",
    "verify:autoads": "node scripts/verify-autoads-paths.mjs",
    "verify:payload": "node scripts/payload-budget.mjs --next .next",
    "qa:dev": "node scripts/qa-server.mjs dev",
    "qa:build": "node scripts/qa-server.mjs build",
    "qa:start": "node scripts/qa-server.mjs start",
    "qa:run": "node scripts/qa-run.mjs",
    "qa:lighthouse": "node scripts/qa-lighthouse.mjs",
    "qa:safety": "node scripts/verify-qa-safety.mjs && node --test scripts/__tests__/qa-safety.test.mjs scripts/__tests__/qa-entrypoints.test.mjs scripts/__tests__/qa-production-http.test.mjs scripts/__tests__/qa-production-http-ts.test.mjs && vitest run src/lib/__tests__/liveAds.test.ts src/lib/__tests__/liveServices.test.ts src/lib/__tests__/liveServicesLifecycle.test.ts src/lib/__tests__/captureElement.test.ts",
    "qa:crawl": "node scripts/qa-run.mjs scripts/qa-crawl.ts",
    "qa:quality": "node scripts/qa-page-quality.mjs",
    "qa:share": "node scripts/qa-share-coverage.mjs",
    "qa:english": "node scripts/qa-run.mjs scripts/qa-english.ts",
    "ad-depth": "node scripts/qa-run.mjs scripts/ad-depth-audit.mjs",
    "cf:build": "node scripts/build-production-worker.mjs",
    "cf:verify": "node scripts/verify-production-worker.mjs",
    "qa:cf:build": "node scripts/qa-cloudflare.mjs build",
    "qa:cf:start": "node scripts/qa-cloudflare.mjs start",
    "qa:cf:check": "node scripts/qa-cloudflare.mjs check",
    "qa:cf:http": "node scripts/qa-cloudflare-http.mjs",
    "verify:framework-security": "node scripts/verify-framework-security.mjs",
    "postinstall": "node scripts/patch-next-og-selector.cjs && node scripts/verify-vendored-dependencies.mjs",
    "pages:build": "node scripts/pages-build.mjs build --mode production",
    "pages:verify": "node scripts/pages-build.mjs verify --mode production",
    "qa:pages:build": "node scripts/pages-build.mjs build --mode qa",
    "qa:pages:verify": "node scripts/pages-build.mjs verify --mode qa",
    "qa:pages:start": "node scripts/pages-build.mjs start --mode qa",
    "qa:pages:http": "node scripts/qa-pages-http.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.544.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "^3.2.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "15.5.28",
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/typography": "^0.5.19",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.21",
    "braces": "file:vendor/braces-3.0.3-moneysalary.1.tgz",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "playwright-core": "^1.63.0",
    "postcss": "8.5.30",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "4.151.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.30"
    },
    "postcss-selector-parser": "7.1.6",
    "braces": "$braces",
    "glob": "13.0.6",
    "cloudflare": {
      "formdata-node": "6.0.3"
    }
  }
}
