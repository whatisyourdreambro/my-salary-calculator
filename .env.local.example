# AdSense 광고 단위 슬롯 ID (10자리 숫자)
# AdSense 콘솔 → 광고 → 광고 단위별에서 발급받은 ID를 입력
# - 빈 값이면 해당 위치 광고는 렌더링 자체를 스킵 (안전)
# - Cloudflare Pages 배포 시: Settings → Environment variables 의 Production + Preview 양쪽에 동일하게 등록 필요

NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_CALC_RESULT=
NEXT_PUBLIC_ADSENSE_SLOT_GUIDE_MID=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# 본문 중간 인아티클 광고 (빈 값이면 GUIDE_MID 슬롯으로 폴백)
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=

# Kakao JavaScript SDK 키 — 카카오톡 "진짜 공유창" 활성화용
# developers.kakao.com → 내 애플리케이션 → 앱 키 → JavaScript 키
# 같은 앱의 [플랫폼] > Web 에 https://www.moneysalary.com 등록 필수
# Cloudflare Pages 배포 시: Settings → Environment variables 의 Production + Preview 양쪽 등록 후 재배포
# - 빈 값이면 카카오 버튼은 "링크 복사"로 폴백 (사이트 정상 동작)
NEXT_PUBLIC_KAKAO_JS_KEY=
