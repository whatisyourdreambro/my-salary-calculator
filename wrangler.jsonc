{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moneysalary",
  "account_id": "b01a4e306f09d28f1a0f1d57bda8410d",
  "main": "cloudflare/worker-entry.mjs",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "moneysalary-private-contact",
      "database_id": "bb7628f9-16ea-408d-803f-3414f06e2557",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": false,
    "html_handling": "none",
    "not_found_handling": "none"
  }
  // No canonical routes: Pages serves production. A reviewed cutover commit must add them deliberately.
  // Pages is production; this Worker config is historical and unrouted.
  // Local QA copies wrangler.qa.jsonc and cannot use these production bindings.
}
