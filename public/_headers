# _routes.json 으로 Worker를 우회하는 정적 자산의 캐시 헤더.
# (Worker 우회 경로에는 next.config.mjs headers() 가 적용되지 않으므로 여기서 지정)
# AdSense 크롤러가 고빈도로 가져가는 ads.txt 류는 1일, 불변 이미지류는 1년 캐시.

/ads.txt
  Cache-Control: public, max-age=86400

/app-ads.txt
  Cache-Control: public, max-age=86400

/security.txt
  Cache-Control: public, max-age=86400

/.well-known/*
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/grid.svg
  Cache-Control: public, max-age=31536000, immutable

/logo.svg
  Cache-Control: public, max-age=31536000, immutable

/logo-full.png
  Cache-Control: public, max-age=31536000, immutable

# 기본 OG 카드(구 /opengraph-image 엣지 렌더 대체, 2026-09-23). 디자인 변경 시 파일명 교체 전제로 1일 캐시.
/og-default.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=31536000, immutable

/icon-512.png
  Cache-Control: public, max-age=31536000, immutable

/icon-maskable-192.png
  Cache-Control: public, max-age=31536000, immutable

/icon-maskable-512.png
  Cache-Control: public, max-age=31536000, immutable

# iOS·메신저 스크래퍼가 선언과 무관하게 루트 기본 경로를 조회한다(2026-09-25 STAB-11).
# 파일이 없던 때는 Worker 를 거쳐 431KB 전역 404 HTML 을 받았다. icon-512.png 를 180x180 으로 축소한 정적 파일.
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

/apple-touch-icon-precomposed.png
  Cache-Control: public, max-age=31536000, immutable

/b112e39a5933ca97201c83a7c5d7d91e.txt
  Cache-Control: public, max-age=86400

# 크롤러 메타 파일 4종(2026-09-25 B2). public/ 사본이 아니라 빌드가 src/app 의 robots.ts·sitemap.ts·
# rss.xml·rss-companies.xml 라우트를 프리렌더해 .vercel/output/static 에 쓰는 파일이다
# (public/ 에 두면 동적 라우트가 무효화되는 함정 — 절대 복사하지 말 것).
# 미들웨어 matcher 가 원래 제외하던 경로라 Worker 우회로 잃는 동작(www 301·봇 403)이 없다.
# robots.txt 는 GSC 크롤 통계에서 9/15~9/22 가져오기 실패(0.3~3.8%/일, 그 여파 크롤 96건)가 났고,
# robots.txt 5xx 는 구글 크롤 전체 중단 사유라 Worker CPU 한도(1102)에서 떼어 낸다.
# rss 2종은 우회 전 route 응답 헤더 값 그대로, sitemap 은 기존 max-age=0 대신 1시간.
# Content-Type 은 Pages 가 확장자로 지정한다(배포 후 xml·text/plain 확인).
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

/rss.xml
  Cache-Control: public, max-age=3600, s-maxage=3600

/rss-companies.xml
  Cache-Control: public, max-age=3600, s-maxage=86400

# 서비스워커 킬스위치 — SW 파일이 브라우저 HTTP 캐시에 오래 잡히면 잘못된 SW를
# 즉시 회수할 수 없다. no-cache 로 매 방문 재검증(304)시켜 배포 즉시 교체 보장.
/sw.js
  Cache-Control: no-cache
